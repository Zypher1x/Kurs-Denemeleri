işlem = input('İstediğiniz İşlemi Giriniz:')

if işlem == '+':
    print(sayı1, '+', sayı2, '=', sayı1+sayı2)

elif işlem == '-':
    print(sayı1, '-', sayı2, '=', sayı1-sayı2)

elif işlem == '*':
    print(sayı1, 'x', sayı2, '=', sayı1*sayı2)

elif işlem == '/' and sayı2>0:
    print(sayı1, '/', sayı2, '=', sayı1/sayı2)

elif işlem == '/' and sayı2==0:
    print('0\'a Bölünmez.')

else:
    print('Geçerli Bir İşlem Giriniz')
